{
  "name": "n8n-nodes-agendaforge",
  "version": "0.1.1",
  "description": "n8n community node for AgendaForge — trigger workflows on contact/session/sponsor events and create records.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "agendaforge",
    "event-management",
    "crm"
  ],
  "license": "MIT",
  "homepage": "https://agendaforge.app/docs/n8n",
  "author": {
    "name": "AgendaForge",
    "email": "hello@agendaforge.app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agendaforge/n8n-nodes-agendaforge.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AgendaForgeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AgendaForge/AgendaForge.node.js",
      "dist/nodes/AgendaForge/AgendaForgeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jsonc-eslint-parser": "^3.1.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
